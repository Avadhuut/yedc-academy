# Production Environment Variables
# Copy this file to .env and fill in real values before deploying

# ─── Database ───────────────────────────────────────────
POSTGRES_DB=yedc_academy
POSTGRES_USER=yedc_prod_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Backend (Spring Boot) ──────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/yedc_academy
SPRING_DATASOURCE_USERNAME=yedc_prod_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_SECRET_KEY_HERE_1234567890ABCDEF
JWT_EXPIRATION_MS=604800000

# ─── Razorpay ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# ─── Frontend (Next.js) ────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1

# ─── Domain ─────────────────────────────────────────────
DOMAIN=yourdomain.com
EMAIL=admin@yourdomain.com
