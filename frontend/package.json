{
  "name": "yedc-academy-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "cmd /c \"if exist .next rd /s /q .next & taskkill /F /IM node.exe 2>nul & next dev -p 3000\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop yedc-frontend",
    "pm2:restart": "pm2 restart yedc-frontend",
    "lint": "next lint"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}
